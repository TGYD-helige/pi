{
  "name": "@amaster.ai/pi-task-scheduler",
  "version": "0.1.2-beta.16",
  "description": "Pi extension for cron-based scheduled task management with LLM-callable tools",
  "keywords": ["pi-package", "pi", "extension", "scheduler", "cron", "tasks"],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stores": {
      "types": "./dist/stores.d.ts",
      "default": "./dist/stores.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/TGYD-helige/pi/master/packages/pi-task-scheduler/preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "preview.png",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-task-scheduler"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@amaster.ai/pi-shared": "workspace:*",
    "croner": "^10.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.1",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "typebox": "*",
    "vitest": "^4.0.0"
  }
}
