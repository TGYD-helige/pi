{
  "name": "@amaster.ai/pi-web-access",
  "version": "0.1.2-beta.15",
  "description": "Pi extension for web search, URL content extraction, and image search (Tavily, Kimi, DeepSeek, Mimo, Z.AI, DashScope, Unsplash, and more)",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "web-search",
    "web-access",
    "image-search",
    "tavily",
    "kimi",
    "deepseek",
    "mimo",
    "zai",
    "dashscope",
    "unsplash"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "preview.png",
    "README.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/TGYD-helige/pi/master/packages/pi-web-access/preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-web-access"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src"
  },
  "dependencies": {
    "@amaster.ai/pi-shared": "workspace:*",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.79.1",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/turndown": "^5.0.5",
    "typebox": "1.3.7",
    "vitest": "^4.0.0"
  }
}
