{
  "name": "@amaster.ai/pi-computer-use",
  "version": "0.1.2-beta.15",
  "description": "Cross-platform computer-use tools for Pi desktop automation",
  "keywords": ["pi-package", "pi", "extension", "computer-use", "desktop", "automation", "cua-driver", "mcp"],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "preview.png",
    "README.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/TGYD-helige/pi/master/packages/pi-computer-use/preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-computer-use"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src"
  },
  "dependencies": {
    "@amaster.ai/pi-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "optionalDependencies": {
    "@amaster.ai/pi-computer-use-cua-driver-darwin-universal": "workspace:*",
    "@amaster.ai/pi-computer-use-cua-driver-linux-arm64": "workspace:*",
    "@amaster.ai/pi-computer-use-cua-driver-linux-x64": "workspace:*",
    "@amaster.ai/pi-computer-use-cua-driver-win32-arm64": "workspace:*",
    "@amaster.ai/pi-computer-use-cua-driver-win32-x64": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.79.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "tsup": "^8.4.0",
    "typebox": "*",
    "vitest": "^4.0.0"
  }
}
