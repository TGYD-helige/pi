{
  "name": "@amaster.ai/pi-channels",
  "version": "0.1.2-beta.16",
  "description": "Pi extension for native messaging channels including Feishu, DingTalk, WeCom, and webhooks.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "channels",
    "feishu",
    "dingtalk",
    "wecom",
    "webhooks"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "preview.png",
    "README.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/TGYD-helige/pi/master/packages/pi-channels/preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-channels"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "typebox": "*",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@amaster.ai/pi-shared": "workspace:*",
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "dingtalk-stream": "^2.1.6-beta.1"
  }
}
