{
  "name": "@amaster.ai/pi-memory",
  "version": "0.1.2-beta.16",
  "description": "Pi extension providing persistent curated memory (MEMORY.md + USER.md) injected into the system prompt as a frozen snapshot.",
  "keywords": ["pi-package", "pi", "extension", "memory", "persistence"],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./threat-patterns": {
      "types": "./dist/threat-patterns.d.ts",
      "default": "./dist/threat-patterns.js"
    },
    "./background-extraction": {
      "types": "./dist/background-extraction.d.ts",
      "default": "./dist/background-extraction.js"
    },
    "./consolidation": {
      "types": "./dist/consolidation.d.ts",
      "default": "./dist/consolidation.js"
    },
    "./dreaming-state": {
      "types": "./dist/dreaming-state.d.ts",
      "default": "./dist/dreaming-state.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/TGYD-helige/pi/master/packages/pi-memory/preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "preview.png",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-memory"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@amaster.ai/pi-shared": "workspace:*",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.74.0",
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.80.10",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/proper-lockfile": "^4.1.4",
    "typebox": "*",
    "vitest": "^4.0.0"
  }
}
