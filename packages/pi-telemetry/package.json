{
  "name": "@amaster.ai/pi-telemetry",
  "version": "0.1.2-beta.16",
  "description": "Pi extension for runtime telemetry with Langfuse and OpenTelemetry exporters",
  "keywords": ["pi-package", "pi", "extension", "telemetry", "observability", "langfuse", "opentelemetry", "tracing"],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./langfuse": {
      "types": "./dist/langfuse.d.ts",
      "default": "./dist/langfuse.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "default": "./dist/otel.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "preview.png",
    "README.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/TGYD-helige/pi/master/packages/pi-telemetry/preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-telemetry"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src"
  },
  "dependencies": {
    "@amaster.ai/pi-shared": "workspace:*",
    "langfuse": "^3.38.20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "vitest": "^4.0.0"
  }
}
