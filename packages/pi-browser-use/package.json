{
  "name": "@amaster.ai/pi-browser-use",
  "version": "0.1.2-beta.16",
  "description": "Pi extension for browser automation via chrome-devtools-mcp with browser_ prefixed tools",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "browser",
    "automation",
    "chrome-devtools",
    "mcp"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "bin": {
    "pi-browser-use": "./dist/cli.js"
  },
  "files": [
    "dist",
    "preview.png",
    "README.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/TGYD-helige/pi/master/packages/pi-browser-use/preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-browser-use"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src"
  },
  "dependencies": {
    "@amaster.ai/pi-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chrome-devtools-mcp": "^1.6.0",
    "puppeteer-core": "25.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.80.10",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "tsup": "^8.4.0",
    "typebox": "*",
    "vitest": "^4.0.0"
  }
}
