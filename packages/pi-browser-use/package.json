{
  "name": "@amaster.ai/pi-browser-use",
  "version": "0.1.2-beta.15",
  "description": "Pi extension for browser automation via chrome-devtools-mcp with browser_ prefixed tools",
  "keywords": ["pi-package", "pi", "extension", "browser", "automation", "chrome-devtools", "mcp"],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "bin": {
    "pi-browser-use": "./dist/cli.js"
  },
  "files": [
    "dist",
    "preview.png",
    "README.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/TGYD-helige/pi/master/packages/pi-browser-use/preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "mirrorxCapabilities": [
    "browser_credential_auth_transaction_v1"
  ],
  "mirrorxCredentialBrowserTcb": {
    "package": "chrome-devtools-mcp",
    "version": "1.6.0",
    "mode": "puppeteer_pipe",
    "buildFileCount": 348,
    "buildTreeSha256": "c75935d92332a872c15afb42b36d8488347d03e0f257cd87b107556f9adf1e5c"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-browser-use"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "verify:credential-transport": "node scripts/verify-credential-browser-pipe.mjs"
  },
  "dependencies": {
    "@amaster.ai/pi-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chrome-devtools-mcp": "1.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.80.10",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "tsup": "^8.4.0",
    "typebox": "1.3.7",
    "vitest": "^4.0.0"
  }
}
